NODE_ENV=development
PORT=3000

# Supabase: use the pooled connection string for application traffic.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase: use the direct connection string for Prisma migrations.
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Use a long, random value in every non-test environment.
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN=1h

# Frontend origin used in customer-facing table QR URLs.
PUBLIC_APP_URL="http://localhost:5173"

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS="http://localhost:5173"
