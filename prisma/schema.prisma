generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String       @id @default(uuid()) @db.Uuid
  name            String
  email           String       @unique
  passwordHash    String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  ownedRestaurants Restaurant[] @relation("RestaurantOwner")

  @@index([email])
}

model Restaurant {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  description String?
  address     String?
  isActive    Boolean  @default(true)
  ownerId     String   @db.Uuid
  owner       User     @relation("RestaurantOwner", fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  categories  MenuCategory[]
  items       MenuItem[]
  tables      RestaurantTable[]
  orders      Order[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId, isActive])
}

model MenuCategory {
  id           String     @id @default(uuid()) @db.Uuid
  restaurantId String     @db.Uuid
  name         String
  description  String?
  sortOrder    Int        @default(0)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  items        MenuItem[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([restaurantId, name])
  @@unique([id, restaurantId])
  @@index([restaurantId, sortOrder])
}

model MenuItem {
  id           String       @id @default(uuid()) @db.Uuid
  restaurantId String       @db.Uuid
  categoryId   String       @db.Uuid
  name         String
  description  String?
  price        Decimal      @db.Decimal(10, 2)
  imageUrl     String?
  isAvailable  Boolean      @default(true)
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  category     MenuCategory @relation(fields: [categoryId, restaurantId], references: [id, restaurantId], onDelete: Restrict, onUpdate: Cascade)
  orderItems   OrderItem[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([restaurantId, categoryId])
  @@index([restaurantId, isAvailable])
}

model RestaurantTable {
  id          String     @id @default(uuid()) @db.Uuid
  restaurantId String    @db.Uuid
  tableNumber String
  qrToken     String     @unique
  isActive    Boolean    @default(true)
  isOccupied  Boolean    @default(false)
  activeOrderingSessionToken String?
  restaurant  Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  orders      Order[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([restaurantId, tableNumber])
  @@index([restaurantId, isActive])
  @@index([restaurantId, isOccupied])
}

enum OrderStatus {
  PENDING
  ACCEPTED
  REJECTED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
}

enum PaymentStatus {
  PAYMENT_DUE
  PAID
}

model Order {
  id                String        @id @default(uuid()) @db.Uuid
  restaurantId      String        @db.Uuid
  restaurantTableId String        @db.Uuid
  status            OrderStatus   @default(PENDING)
  paymentMethod     PaymentMethod @default(CASH)
  paymentStatus     PaymentStatus @default(PAYMENT_DUE)
  paymentCollectedAt DateTime?
  totalAmount       Decimal       @db.Decimal(10, 2)
  trackingToken     String        @unique
  orderingSessionToken String?
  customerName      String?
  customerContact   String?
  estimatedReadyAt  DateTime?
  etaSetAt          DateTime?
  completedAt       DateTime?
  restaurant        Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  restaurantTable   RestaurantTable @relation(fields: [restaurantTableId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  items             OrderItem[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([restaurantId, createdAt])
  @@index([restaurantTableId, createdAt])
  @@index([restaurantTableId, orderingSessionToken, createdAt])
  @@index([restaurantId, status, createdAt])
}

model OrderItem {
  id          String    @id @default(uuid()) @db.Uuid
  orderId     String    @db.Uuid
  menuItemId  String?   @db.Uuid
  itemName    String
  unitPrice   Decimal   @db.Decimal(10, 2)
  quantity    Int
  lineSubtotal Decimal  @db.Decimal(10, 2)
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  menuItem    MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([orderId])
  @@index([menuItemId])
}
